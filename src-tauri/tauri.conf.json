
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "launcher",
  "version": "0.1.1",
  "identifier": "com.mesjeux.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "launcher",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5nIHB1YmxpYyBrZXk6IDlDRjQyNTMwQUYxNUVBNkYKUldSdjZoV3ZNQ1gwblBPTnZGN3lxMjNOV3hGQU5mSkxDRHRnY0hzSjRWYWJ6U0xSMjlFRUhyZWQK",
      "endpoints": [
        "https://github.com/ErwanBkiuw/NEXUSPLAY/releases/latest/download/latest.json"
      ]
    }
  }
}
